<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" targetNamespace="https://momentum.local/plm/workflow">
  <bpmn:process id="materialApproval" name="物料主数据审批" isExecutable="true">
    <bpmn:startEvent id="materialStart" name="提交物料申请"/><bpmn:userTask id="materialReview" name="物料评审" flowable:assignee="${assignee}"/><bpmn:exclusiveGateway id="materialDecision" name="审批结果"/><bpmn:endEvent id="materialApproved" name="已批准"/><bpmn:endEvent id="materialRejected" name="已驳回"/>
    <bpmn:sequenceFlow id="materialFlow1" sourceRef="materialStart" targetRef="materialReview"/><bpmn:sequenceFlow id="materialFlow2" sourceRef="materialReview" targetRef="materialDecision"/><bpmn:sequenceFlow id="materialFlowApproved" sourceRef="materialDecision" targetRef="materialApproved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'approved'}]]></bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="materialFlowRejected" sourceRef="materialDecision" targetRef="materialRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'rejected'}]]></bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="bomReleaseApproval" name="BOM 修订发布审批" isExecutable="true">
