  </bpmn:process>
  <bpmn:process id="documentReleaseApproval" name="图文档修订与发布审批" isExecutable="true">
    <bpmn:startEvent id="documentStart" name="提交文档修订"/><bpmn:userTask id="documentReview" name="图文档评审" flowable:assignee="${assignee}"/><bpmn:exclusiveGateway id="documentDecision" name="审批结果"/><bpmn:endEvent id="documentApproved" name="已批准"/><bpmn:endEvent id="documentRejected" name="已驳回"/>
    <bpmn:sequenceFlow id="documentFlow1" sourceRef="documentStart" targetRef="documentReview"/><bpmn:sequenceFlow id="documentFlow2" sourceRef="documentReview" targetRef="documentDecision"/><bpmn:sequenceFlow id="documentFlowApproved" sourceRef="documentDecision" targetRef="documentApproved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'approved'}]]></bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="documentFlowRejected" sourceRef="documentDecision" targetRef="documentRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'rejected'}]]></bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="performanceReviewApproval" name="绩效评审审批" isExecutable="true">
    <bpmn:startEvent id="performanceStart" name="提交绩效评审"/><bpmn:userTask id="performanceReview" name="绩效复核" flowable:assignee="${assignee}"/><bpmn:exclusiveGateway id="performanceDecision" name="审批结果"/><bpmn:endEvent id="performanceApproved" name="已批准"/><bpmn:endEvent id="performanceRejected" name="退回修订"/>
    <bpmn:sequenceFlow id="performanceFlow1" sourceRef="performanceStart" targetRef="performanceReview"/><bpmn:sequenceFlow id="performanceFlow2" sourceRef="performanceReview" targetRef="performanceDecision"/><bpmn:sequenceFlow id="performanceFlowApproved" sourceRef="performanceDecision" targetRef="performanceApproved"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'approved'}]]></bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="performanceFlowRejected" sourceRef="performanceDecision" targetRef="performanceRejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[${approvalDecision == 'rejected'}]]></bpmn:conditionExpression></bpmn:sequenceFlow>
  </bpmn:process>
