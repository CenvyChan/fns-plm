# 本地 Node API
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_FILE=
LEGACY_DATA_FILE=
DATA_FILE=
DOCUMENT_STORAGE_DIR=
INTEGRATION_DATA_DIR=

# 生产环境推荐通过 APP_ENCRYPTION_KEY_FILE 管理 32 字节密钥文件；不提交真实密钥。
# 若使用 APP_ENCRYPTION_KEY，必须为恰好 64 位十六进制字符串。
APP_ENCRYPTION_KEY_FILE=
APP_ENCRYPTION_KEY=

# 可选 Redis：多副本报告任务去重/查询缓存。留空时使用进程内回退，不具备跨副本去重。
REDIS_URL=

# 浏览器允许来源；生产配置准确 HTTPS origin，不要使用宽泛通配符。
CORS_ORIGIN=
PUBLIC_APP_URL=

# Flowable/钉钉环境默认值只有在以下三项完整匹配时才应用；K3Cloud 连接信息仅通过 PLM 页面保存。
CONNECTOR_DEFAULT_TENANT_ID=
CONNECTOR_DEFAULT_ORGANIZATION_ID=
CONNECTOR_DEFAULT_ACCOUNT_ID=

# Flowable 独立 REST 引擎；每个连接器配置行绑定完整 tenant/org/account 三元组。
# 内置 Ubuntu Flowable 服务的完整 Base URL 示例：http://127.0.0.1:8090/flowable-rest/process-api
FLOWABLE_BASE_URL=
FLOWABLE_USERNAME=
FLOWABLE_PASSWORD=
FLOWABLE_TIMEOUT_MS=10000
FLOWABLE_USER_MAP_JSON={}

# K3Cloud 当前只读；凭证、地址、账套与 allowlist 均在「系统集成与连接器」中加密保存。
# APP_ENCRYPTION_KEY（或 APP_ENCRYPTION_KEY_FILE）只供服务端解密配置，不要放 K3Cloud 凭证到环境变量。
K3CLOUD_TIMEOUT_MS=20000

# 钉钉群机器人通知；若启用卡片回调，另配置 CorpId/AppKey/AppSecret/模板与身份映射。
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
DINGTALK_CARD_CALLBACK_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CORP_ID=
DINGTALK_USER_MAP_JSON={}

# 钉钉小程序企业免登；凭证必须显式绑定一个有效的内部 tenant/org/account 三元组。
# 只存于服务端环境，不进小程序源码；缺少任一范围 ID 时 API 明确返回未配置。
DINGTALK_SSO_CLIENT_ID=
DINGTALK_SSO_CLIENT_SECRET=
DINGTALK_SSO_CORP_ID=
DINGTALK_SSO_TENANT_ID=
DINGTALK_SSO_ORGANIZATION_ID=
DINGTALK_SSO_ACCOUNT_ID=
