[Unit]
Description=Momentum PLM and Personal Workspace API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=momentum
Group=momentum
WorkingDirectory=/opt/momentum/current/server
EnvironmentFile=-/etc/momentum/momentum.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=DATABASE_FILE=/var/lib/momentum/momentum.sqlite
Environment=APP_ENCRYPTION_KEY_FILE=/var/lib/momentum/.app-encryption-key
Environment=DOCUMENT_STORAGE_DIR=/var/lib/momentum/documents
Environment=INTEGRATION_DATA_DIR=/var/lib/momentum
ExecStart=/usr/bin/node /opt/momentum/current/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/momentum
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
