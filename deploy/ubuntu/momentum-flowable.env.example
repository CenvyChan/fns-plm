# 必须替换为随机生成的 24 字符以上服务密码；与 Node API 对应的 FLOWABLE_USERNAME/PASSWORD 一致
FLOWABLE_REST_USERNAME=momentum-api
FLOWABLE_REST_PASSWORD=

# 仅回环监听；不要将 REST 引擎直接暴露到公网
FLOWABLE_HOST=127.0.0.1
FLOWABLE_PORT=8090
FLOWABLE_DATA_DIR=/var/lib/momentum-flowable

# 默认单节点持久 H2。生产高可用环境建议使用专用 PostgreSQL 数据库与备份策略。
FLOWABLE_DB_URL=jdbc:h2:file:/var/lib/momentum-flowable/flowable;DB_CLOSE_ON_EXIT=FALSE
FLOWABLE_DB_DRIVER=org.h2.Driver
FLOWABLE_DB_USERNAME=sa
FLOWABLE_DB_PASSWORD=
