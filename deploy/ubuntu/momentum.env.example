# Redis 可选。若装有本机 Redis，使用以下地址；未启用时可留空回退到进程内缓存
REDIS_URL=redis://127.0.0.1:6379

# 企业前端来源按实际 TLS 域名填写；留空时生产 API 不发送宽泛 CORS 头
CORS_ORIGIN=
PUBLIC_APP_URL=

# systemd 默认在 /var/lib/momentum 持久化 SQLite、密钥与受控文件；如需调整，确保目录归 momentum 用户所有
DATABASE_FILE=/var/lib/momentum/momentum.sqlite
APP_ENCRYPTION_KEY_FILE=/var/lib/momentum/.app-encryption-key
DOCUMENT_STORAGE_DIR=/var/lib/momentum/documents

# Flowable/钉钉环境默认值只有在完整匹配该内部范围时生效；K3Cloud 只在 PLM 页面配置。
CONNECTOR_DEFAULT_TENANT_ID=
CONNECTOR_DEFAULT_ORGANIZATION_ID=
CONNECTOR_DEFAULT_ACCOUNT_ID=

# K3Cloud 的 AppId/AppSecret、地址、账套与 allowlist 只在「系统集成与连接器」中加密保存。
# Docker 只需向后端提供稳定的 APP_ENCRYPTION_KEY（64 位十六进制）或持久化 APP_ENCRYPTION_KEY_FILE。
FLOWABLE_BASE_URL=
FLOWABLE_USERNAME=
FLOWABLE_PASSWORD=
FLOWABLE_TIMEOUT_MS=10000
FLOWABLE_USER_MAP_JSON={}
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
DINGTALK_CARD_CALLBACK_SECRET=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_CORP_ID=
DINGTALK_USER_MAP_JSON={}
# 钉钉小程序企业免登：必须绑定一个有效内部 tenant/org/account，未填范围时会 fail closed。
# Client Secret 仅保存在受限服务端环境文件，切勿写入小程序或前端。
DINGTALK_SSO_CLIENT_ID=
DINGTALK_SSO_CLIENT_SECRET=
DINGTALK_SSO_CORP_ID=
DINGTALK_SSO_TENANT_ID=
DINGTALK_SSO_ORGANIZATION_ID=
DINGTALK_SSO_ACCOUNT_ID=
