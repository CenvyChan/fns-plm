.page { padding: 28rpx 30rpx; }
.hero { padding: 42rpx 34rpx; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg,#2563eb,#4f8df7); display:flex; flex-direction:column; }
.eyebrow { font-size: 24rpx; opacity:.85; }.title { font-size: 42rpx; font-weight:700; margin: 16rpx 0; }.subtitle { font-size:26rpx; opacity:.9; }
.section-title { font-size:30rpx; font-weight:700; margin:42rpx 4rpx 18rpx; }
.entry { background:#fff; border-radius:20rpx; padding:26rpx 24rpx; margin-bottom:18rpx; display:flex; align-items:center; }
.icon { width:72rpx;height:72rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:28rpx; }.blue {color:#2563eb;background:#eaf1ff}.green {color:#16a36a;background:#e6f7ef}
.entry-copy {display:flex;flex-direction:column;flex:1;margin-left:20rpx}.entry-title {font-weight:650;font-size:30rpx}.entry-sub {font-size:24rpx;color:#8791a2;margin-top:8rpx}.arrow {font-size:42rpx;color:#aab2bf}.note {display:block;text-align:center;color:#9aa3b2;font-size:23rpx;margin-top:30rpx}.signout {margin-top:36rpx;border:1rpx solid #dce3ef;background:#fff;color:#52627a;border-radius:14rpx;font-size:26rpx}
