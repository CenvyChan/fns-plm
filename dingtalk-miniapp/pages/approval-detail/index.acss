.page {padding:30rpx 28rpx}.heading {margin:8rpx 4rpx 26rpx}.title {font-size:40rpx;font-weight:700;display:block}.subtitle {font-size:23rpx;color:#8791a2;margin-top:10rpx;display:block}.card {background:#fff;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.task-title {font-size:32rpx;font-weight:700;display:block;margin-bottom:24rpx}.row {display:flex;justify-content:space-between;padding:17rpx 0;border-bottom:1rpx solid #f0f2f5;font-size:25rpx}.label {color:#8791a2}.description {padding-top:20rpx;display:flex;flex-direction:column}.body {font-size:26rpx;line-height:1.6;margin-top:12rpx}.comment-card>.label {font-size:27rpx;font-weight:600;color:#344054}.comment {width:100%;height:180rpx;background:#f7f8fb;border-radius:12rpx;padding:20rpx;margin-top:18rpx;font-size:25rpx}.actions {display:flex;gap:18rpx;margin-top:24rpx}.actions button {flex:1;border-radius:12rpx;font-size:28rpx}.reject {color:#d64545;background:#fff0f0}.approve {color:#fff;background:#2563eb}.state,.error {padding:45rpx 15rpx;text-align:center;color:#8993a3;font-size:25rpx}.error {color:#b84a4a}.mode-note {margin:0 0 20rpx;padding:18rpx 20rpx;border:1rpx solid #f4dfb3;border-radius:12rpx;background:#fff7e6;color:#805d19;font-size:23rpx;line-height:1.55}
