<view class="page">
  <view class="heading"><text class="title">我的审批</text><text class="subtitle">待处理工作流任务</text></view>
  <view a:if="{{loading}}" class="state">正在加载任务…</view>
  <view a:if="{{error}}" class="error"><text>{{error}}</text><text class="retry" onTap="loadTasks">重试</text></view>
  <view a:if="{{!loading && !error && tasks.length === 0}}" class="state">暂无待办任务</view>
  <view a:for="{{tasks}}" a:key="id" class="task" data-id="{{item.id}}" onTap="openTask">
    <view class="task-top"><text class="task-title">{{item.title || item.name || '审批任务'}}</text><text class="badge">待处理</text></view>
    <text class="meta">编号：{{item.id}}</text><text a:if="{{item.createdAt}}" class="meta">创建时间：{{item.createdAt}}</text>
    <text class="view-link">查看详情　›</text>
  </view>
</view>
