.page {padding:32rpx 28rpx}.heading {margin:8rpx 4rpx 28rpx}.title {display:block;font-size:40rpx;font-weight:700}.subtitle {display:block;color:#8791a2;font-size:25rpx;margin-top:10rpx}.task {background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:18rpx}.task-top {display:flex;justify-content:space-between;align-items:center}.task-title {font-size:30rpx;font-weight:650}.badge {font-size:21rpx;color:#d48319;background:#fff4dc;padding:8rpx 14rpx;border-radius:20rpx}.meta {display:block;font-size:23rpx;color:#8791a2;margin-top:16rpx}.view-link {display:block;text-align:right;color:#2563eb;font-size:24rpx;margin-top:20rpx}.state,.error {padding:70rpx 20rpx;text-align:center;color:#8a94a5;font-size:26rpx}.error {color:#b84a4a}.retry {color:#2563eb;margin-left:20rpx}.mode-note {margin:0 0 20rpx;padding:18rpx 20rpx;border:1rpx solid #f4dfb3;border-radius:12rpx;background:#fff7e6;color:#805d19;font-size:23rpx;line-height:1.55}.mode-note.live {border-color:#cfe7d8;background:#effaf2;color:#28633a}
