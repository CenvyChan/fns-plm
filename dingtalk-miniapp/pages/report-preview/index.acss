.page{padding:30rpx 28rpx}.heading{margin:8rpx 4rpx 26rpx}.title{font-size:40rpx;font-weight:700;display:block}.subtitle{font-size:24rpx;color:#8791a2;display:block;margin-top:10rpx}.card{background:#fff;border-radius:20rpx;padding:28rpx}.report-title{display:block;font-size:32rpx;font-weight:700}.period{display:block;font-size:22rpx;color:#8791a2;margin-top:12rpx}.metric{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #f0f2f5;font-size:25rpx}.value{font-weight:700;color:#2563eb}.summary{display:block;margin-top:24rpx;font-size:25rpx;line-height:1.6;color:#536071}.markdown{display:block;margin-top:24rpx;padding:20rpx;border-radius:12rpx;background:#f7f8fb;color:#536071;font-size:23rpx;line-height:1.7;white-space:pre-wrap;word-break:break-word}.empty,.state,.error{display:block;text-align:center;padding:44rpx 18rpx;color:#8b95a5;font-size:25rpx}.error{color:#b84a4a}
