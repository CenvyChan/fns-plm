.page{padding:32rpx 30rpx;background:#f5f7fb;min-height:100vh;box-sizing:border-box}.hero{padding:42rpx 34rpx;border-radius:24rpx;color:#fff;background:linear-gradient(135deg,#243b76,#3577d4);display:flex;flex-direction:column}.eyebrow{font-size:22rpx;letter-spacing:2rpx;opacity:.8}.title{font-size:42rpx;font-weight:700;margin:16rpx 0}.subtitle{font-size:25rpx;opacity:.9}.card{background:#fff;border-radius:22rpx;padding:32rpx;margin-top:26rpx;box-shadow:0 10rpx 36rpx rgba(25,48,90,.06)}.label{display:block;font-size:25rpx;font-weight:600;color:#374151;margin:24rpx 0 10rpx}.input{height:84rpx;padding:0 20rpx;background:#f6f8fb;border:1rpx solid #e8ebf1;border-radius:12rpx;font-size:27rpx}.primary{margin-top:30rpx;border-radius:14rpx;background:#2868d7;color:#fff;font-size:29rpx}.error{margin-top:16rpx;padding:16rpx;border-radius:10rpx;background:#fff0ef;color:#b83a35;font-size:24rpx}.hint{display:block;color:#8a94a5;font-size:22rpx;line-height:1.55;margin-top:24rpx}.signed-in{display:block;color:#263a5b;font-weight:700;font-size:29rpx}.picker{padding:23rpx 20rpx;background:#f6f8fb;border:1rpx solid #e8ebf1;border-radius:12rpx;color:#263a5b;font-size:26rpx}

.notice{padding:20rpx;border-radius:12rpx;background:#fff7e6;border:1rpx solid #f4dfb3;color:#805d19;font-size:24rpx;line-height:1.6}.secondary{margin-top:20rpx;border:1rpx solid #dce3ee;border-radius:14rpx;background:#fff;color:#3f5a82;font-size:26rpx}.password-fallback{margin-top:18rpx;padding-top:12rpx;border-top:1rpx solid #eef0f4}
